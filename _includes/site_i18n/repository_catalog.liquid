{% comment %}
  Complete list of public repositories, grouped by area, as compact tables.
  Data: _data/repository_catalog.json (synchronized from the GitHub API by bin/sync_repository_catalog.rb).
{% endcomment %}
{% assign current_lang = page.lang | default: site.lang %}
{% assign strings = site.data.i18n[current_lang] | default: site.data.i18n[site.lang] %}
{% assign current_locale = site.data.locales | where: 'code', current_lang | first %}
{% assign catalog_locale = current_locale.data_key %}
{% assign catalog = site.data.repository_catalog %}
{% assign catalog_i18n = site.data.repository_catalog_i18n %}
{% assign repositories_route = site.data.translation_routes.repositories[current_lang] %}

<p class="lead">
  {% if current_lang == 'zh-CN' %}
    这里列出
    <a href="https://github.com/{{ catalog.owner | escape }}" target="_blank" rel="noopener noreferrer">@{{ catalog.owner | escape }}</a>
    的全部 {{ catalog.public_count }} 个公开仓库，并标明每个仓库是原创、研究、课程、公开课自学、实验还是派生仓库。
  {% elsif current_lang == 'ja' %}
    <a href="https://github.com/{{ catalog.owner | escape }}" target="_blank" rel="noopener noreferrer">@{{ catalog.owner | escape }}</a>
    の公開リポジトリ {{ catalog.public_count }} 件をすべて載せ、オリジナル・研究・授業・公開講座の自習・実験・フォークの別を示しています。
  {% else %}
    All {{ catalog.public_count }} public repositories from
    <a href="https://github.com/{{ catalog.owner | escape }}" target="_blank" rel="noopener noreferrer">@{{ catalog.owner | escape }}</a>, each marked
    as original work, research, coursework, self-study, experiment, or fork.
  {% endif %}
</p>

<p class="text-muted small">
  {{ strings.catalog.synchronized }}
  {{ catalog.synced_at | date: '%Y-%m-%d' }}. <a href="{{ repositories_route | relative_url }}">{{ strings.catalog.pinned }}</a> ·
  <a href="https://github.com/{{ catalog.owner | escape }}?tab=repositories" target="_blank" rel="noopener noreferrer">
    {{- strings.catalog.github -}}
  </a>
</p>

<p aria-label="{{ strings.a11y.repository_source_summary }}">
  {% for source in catalog.source_counts %}
    {% assign source_label = source[0] | replace: '-', ' ' %}
    {% if catalog_locale != 'en' and catalog_i18n.source_kinds[source[0]][catalog_locale] %}
      {% assign source_label = catalog_i18n.source_kinds[source[0]][catalog_locale] %}
    {% endif %}
    <span class="badge badge-light border mr-1 mb-1">{{ source_label | escape }} · {{ source[1] }}</span>
  {% endfor %}
</p>

<p>
  {% for category in catalog.categories %}
    {% if category.count == 0 %}
      {% continue %}
    {% endif %}
    {% assign category_title = category.title %}
    {% if catalog_locale != 'en' and catalog_i18n.categories[category.slug][catalog_locale].title %}
      {% assign category_title = catalog_i18n.categories[category.slug][catalog_locale].title %}
    {% endif %}
    <a href="#{{ category.slug | escape }}">{{ category_title | escape }}</a> <span class="text-muted">({{ category.count }})</span>
    {%- unless forloop.last %} · {% endunless %}
  {% endfor %}
</p>

{% for category in catalog.categories %}
  {% if category.count == 0 %}
    {% continue %}
  {% endif %}
  {% assign category_repositories = catalog.repositories | where: 'category', category.slug %}
  {% assign category_title = category.title %}
  {% assign category_description = category.description %}
  {% if catalog_locale != 'en' and catalog_i18n.categories[category.slug][catalog_locale] %}
    {% assign localized_category = catalog_i18n.categories[category.slug][catalog_locale] %}
    {% assign category_title = localized_category.title | default: category.title %}
    {% assign category_description = localized_category.description | default: category.description %}
  {% endif %}

  <section class="mt-5" aria-labelledby="{{ category.slug | escape }}">
    <h2 class="h4" id="{{ category.slug | escape }}">{{ category_title | escape }}</h2>
    <p class="text-muted small">{{ category_description | escape }}</p>
    <div class="table-responsive">
      <table class="table table-sm catalog-table" data-catalog-table="{{ category.slug | escape }}">
        <tbody>
          {% for repository in category_repositories %}
            {% assign repository_description = repository.description %}
            {% if catalog_locale != 'en' and catalog_i18n.repositories[repository.slug][catalog_locale] %}
              {% assign localized_repository = catalog_i18n.repositories[repository.slug][catalog_locale] %}
              {% assign repository_description = localized_repository.description | default: localized_repository %}
            {% endif %}
            {% assign source_label = repository.source_kind | replace: '-', ' ' %}
            {% if catalog_locale != 'en' and catalog_i18n.source_kinds[repository.source_kind][catalog_locale] %}
              {% assign source_label = catalog_i18n.source_kinds[repository.source_kind][catalog_locale] %}
            {% endif %}
            {% assign repository_detail_routes = site.data.translation_routes[repository.slug] %}
            {% assign repository_detail_url = null %}
            {% if repository_detail_routes and repository_detail_routes[current_lang] %}
              {% assign repository_detail_url = repository_detail_routes[current_lang] %}
            {% endif %}
            {% assign primary_language = repository.languages | first %}
            <tr id="{{ repository.slug | escape }}" data-catalog-repository="{{ repository.slug | escape }}">
              <td class="catalog-name">
                {% if repository_detail_url %}
                  <a href="{{ repository_detail_url | relative_url | escape }}"
                    ><strong>{{ repository.title | escape }}</strong></a
                  >
                {% else %}
                  <a href="{{ repository.source_url | escape }}" target="_blank" rel="noopener noreferrer"
                    ><strong>{{ repository.title | escape }}</strong></a
                  >
                {% endif %}
                <br>
                <span class="badge badge-light border">{{ source_label | escape }}</span>
                {% if repository.archived %}
                  <span class="badge badge-warning">{{ strings.catalog.archived }}</span>
                {% endif %}
              </td>
              <td>
                {{ repository_description | escape }}
                <span class="text-muted small d-block">
                  {% if primary_language %}{{ primary_language | escape }} · {% endif %}
                  {{- strings.catalog.updated }}
                  {{ repository.pushed_at | date: '%Y-%m-%d' }}
                  · <a href="{{ repository.source_url | escape }}" target="_blank" rel="noopener noreferrer">{{ strings.catalog.source }}</a>
                  {% if repository.demo_url %}
                    · <a href="{{ repository.demo_url | escape }}" target="_blank" rel="noopener noreferrer">{{ strings.catalog.demo }}</a>
                  {% endif %}
                </span>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
{% endfor %}

<style>
  .catalog-table td {
    vertical-align: top;
    border-color: var(--global-divider-color);
  }
  .catalog-table .catalog-name {
    width: 14rem;
    overflow-wrap: anywhere;
  }
  .catalog-table tr {
    scroll-margin-top: 5rem;
  }
</style>
